+/* --- One lifted, curling corner ----------------------------------------
+   The north star lifts the CENTRE piece. The flap shows the paper's own
+   magenta back, never the photograph underneath, so nothing is given away.
+   ::after is free on this scrap — the printer's mark lives on scrap 8.
+
+   This is the part that does not generalise: it is hand-placed on one grid
+   index, it has no idea whether that scrap has been torn, and a second
+   lifted corner means a second hand-built shape.
+   -------------------------------------------------------------------- */
+.df-scrap[data-i="4"]::after {
+  content: ''; position: absolute; right: 0; bottom: 0;
+  width: 34%; height: 34%; pointer-events: none; opacity: 1;
+  /* A dog-ear: the corner folded back on the diagonal, so what shows is the
+     paper's own magenta back. The fold runs corner to corner — the 50% mark
+     of a 135deg gradient — so all the shading has to happen in the second
+     half of the ramp: dark where the sheet turns over, opening out to the
+     flat back at the tip. */
+  background: linear-gradient(135deg,
+    transparent 0 47%, #5E0E49 47% 53%, #A81E85 53% 66%,
+    #C82BA1 66% 84%, var(--df-magenta) 84% 100%);
+  /* the free rim is torn; the fold is not */
+  clip-path: polygon(
+    100% 2%, 92% 11%, 87% 16%, 79% 25%, 73% 30%, 64% 39%,
+    58% 44%, 50% 53%, 43% 58%, 35% 67%, 28% 72%, 20% 81%,
+    13% 86%, 5% 95%, 2% 100%, 100% 100%);
+  /* the lifted flap floats: its ink falls back onto the sheet it came off */
+  filter: drop-shadow(-1.6px -1.6px 0 rgba(11,11,11,.40));
+  transform: none; z-index: 2;
+}
+/* the flap is paper, not a watermark: the locked-state dimming that rides on
+   ::after (style.css `.df-scrap.locked::after { opacity: .5 }`) must not
+   reach it. One of the escape hatches the shared pseudo-element costs. */
+.df-scrap[data-i="4"].locked::after { opacity: 1; }
