+
+
+/* ##########################################################################
+   PAPER-SCRAPS MOCKUP — candidate-1-cheap-80.css
+   Appended block. A shipping version would fold these overrides
+   into the .df-scrap rules above rather than restating them.
+   ########################################################################## */
+/* ==========================================================================
+   CANDIDATE 1 — "THE CHEAP 80%"                       (mockup, 7 Aug 2026)
+   Paper-scraps art direction. NOT SHIPPED. Nothing here touches game logic,
+   adjacency, scoring, saved games, sound or accessibility behaviour.
+
+   The complaint: nine identically stamped squares read as branded wrapping
+   paper, or as game tiles, rather than as one sheet of paper torn apart.
+
+   The fix, in three moves, all pure CSS, no new assets:
+     1. ONE printer's mark instead of nine watermarks. A chop in the corner
+        of a sheet reads as print; the same chop nine times reads as a
+        repeat pattern.
+     2. Nine sheets, not one mould. Each scrap gets its own paper shade,
+        its own grain angle, its own halftone-dot offset and its own extra
+        fraction of a degree of rotation.
+     3. Nine pieces lying on each other. A 1.5px hard ink shadow per scrap
+        plus a reversed paint order, so each piece sits ON the ones down
+        and to its right — the same hard-shadow language as the house's
+        `box-shadow: 3px 3px 0 var(--ch-ink)` cards.
+
+   Applied as an append to css/style.css (it only overrides the existing
+   `.df-scrap` block); a shipping version would fold it into that block.
+   ========================================================================== */
+
+/* --- Paper stock: same recipe, now driven by per-scrap variables --------- */
+.df-scrap {
+  /* the three gradient stops, the grain angle, the dot ink and the dot
+     offset are all per-scrap below; these are the defaults. */
+  --p1: #F4F0E4; --p2: #EDE7D5; --p3: #E4DDC8;
+  --grain: 160deg;
+  --dot-ink: rgba(11,11,11,.08);
+  --dot-x: 0px; --dot-y: 0px;
+  /* `locked` paints a whisper of grey through this layer (see below): with
+     the watermark gone, the locked state needs its own quiet mark. */
+  --veil: rgba(11,11,11,0);
+  background:
+    linear-gradient(var(--veil), var(--veil)),
+    radial-gradient(var(--dot-ink) 1px, transparent 1.2px) var(--dot-x) var(--dot-y) / 9px 9px,
+    linear-gradient(var(--grain), var(--p1) 0%, var(--p2) 55%, var(--p3) 100%);
+  /* A hard ink shadow, not a blur — the house draws shadows as offset ink.
+     3% over-scale closes the slivers of photograph that the existing ±2deg
+     rotations open along the seams, and buys the overlap the shadow needs
+     to fall on. */
+  box-shadow: 1.5px 1.5px 0 rgba(11,11,11,.17);
+  scale: 1.03;
+}
+
+/* Reversed paint order: scrap 0 on top, scrap 8 at the bottom, so every
+   piece's down-right shadow lands on the piece it overlaps. Torn scraps are
+   opacity 0 / pointer-events none, so this changes nothing about hit
+   testing or the tear. */
+.df-scrap[data-i="0"] { z-index: 9; }
+.df-scrap[data-i="1"] { z-index: 8; }
+.df-scrap[data-i="2"] { z-index: 7; }
+.df-scrap[data-i="3"] { z-index: 6; }
+.df-scrap[data-i="4"] { z-index: 5; }
+.df-scrap[data-i="5"] { z-index: 4; }
+.df-scrap[data-i="6"] { z-index: 3; }
+.df-scrap[data-i="7"] { z-index: 2; }
+.df-scrap[data-i="8"] { z-index: 1; }
+
+/* --- Nine sheets off the same ream -------------------------------------
+   Tones stay inside a 5-value band around the current stock, so this reads
+   as "same paper, different sheets", never as a patchwork. `rotate` is the
+   independent transform property, so it ADDS to the inline rotation the
+   game already sets (js/revealgame.js buildScraps) without fighting it —
+   the tell-tale −2/0/2/−1/1 repeat stops being visible.
+   -------------------------------------------------------------------- */
+.df-scrap[data-i="0"] { --p1:#F6F2E7; --p2:#EFE9D8; --p3:#E5DECA; --grain:160deg; --dot-x:0px;  --dot-y:0px; --dot-ink:rgba(11,11,11,.085); rotate:  .70deg; border-color: rgba(11,11,11,.50); }
+.df-scrap[data-i="1"] { --p1:#F2EEE1; --p2:#EBE5D2; --p3:#E2DBC5; --grain:148deg; --dot-x:3px;  --dot-y:2px; --dot-ink:rgba(11,11,11,.070); rotate: -.50deg; border-color: rgba(11,11,11,.44); }
+.df-scrap[data-i="2"] { --p1:#F5F1E6; --p2:#EEE8D6; --p3:#E6DFCB; --grain:172deg; --dot-x:5px;  --dot-y:6px; --dot-ink:rgba(11,11,11,.090); rotate:  .40deg; border-color: rgba(11,11,11,.52); }
+.df-scrap[data-i="3"] { --p1:#F3EFE3; --p2:#ECE6D4; --p3:#E3DCC7; --grain:155deg; --dot-x:1px;  --dot-y:4px; --dot-ink:rgba(11,11,11,.065); rotate:  .90deg; border-color: rgba(11,11,11,.42); }
+.df-scrap[data-i="4"] { --p1:#F6F2E6; --p2:#F0EAD9; --p3:#E7E0CC; --grain:166deg; --dot-x:6px;  --dot-y:1px; --dot-ink:rgba(11,11,11,.080); rotate: -.80deg; border-color: rgba(11,11,11,.50); }
+.df-scrap[data-i="5"] { --p1:#F1EDE0; --p2:#EAE4D1; --p3:#E1DAC4; --grain:143deg; --dot-x:2px;  --dot-y:7px; --dot-ink:rgba(11,11,11,.075); rotate:  .50deg; border-color: rgba(11,11,11,.47); }
+.df-scrap[data-i="6"] { --p1:#F5F0E5; --p2:#EEE7D5; --p3:#E5DEC9; --grain:176deg; --dot-x:7px;  --dot-y:3px; --dot-ink:rgba(11,11,11,.060); rotate:  .90deg; border-color: rgba(11,11,11,.44); }
+.df-scrap[data-i="7"] { --p1:#F3EFE4; --p2:#EDE7D6; --p3:#E4DDC9; --grain:151deg; --dot-x:4px;  --dot-y:5px; --dot-ink:rgba(11,11,11,.088); rotate: -.60deg; border-color: rgba(11,11,11,.52); }
+.df-scrap[data-i="8"] { --p1:#F4F0E5; --p2:#EDE7D5; --p3:#E4DDC8; --grain:160deg; --dot-x:0px;  --dot-y:8px; --dot-ink:rgba(11,11,11,.078); rotate:  .35deg; border-color: rgba(11,11,11,.47); }
+
+/* --- One printer's mark, not nine watermarks ---------------------------
+   Eight scraps carry nothing. The ninth carries the house name once, small,
+   in the corner where a plate mark lives — bottom-right, the last corner a
+   3x3 usually loses. Same string, same −14deg, roughly a ninth of the ink.
+   -------------------------------------------------------------------- */
+.df-scrap::after { content: ''; }
+
+.df-scrap[data-i="8"]::after {
+  content: 'YESTERNERD';
+  position: absolute; right: 9px; bottom: 15px;
+  font-family: var(--ch-font-ui); font-size: 7px; font-weight: 700;
+  letter-spacing: .14em; color: rgba(11,11,11,.26);
+  /* the −14deg swings the far end of the line downward, so the mark sits a
+     line-and-a-half up from the paper's edge to keep its tail off the ink
+     frame (the frame clips: #rv-frame is overflow:hidden). */
+  transform: rotate(-14deg); transform-origin: 100% 100%;
+  white-space: nowrap; pointer-events: none;
+}
+
+/* --- Locked keeps its own mark ------------------------------------------
+   Today a locked scrap is signalled by `.df-scrap.locked::after {opacity:.5}`
+   — a dimmer watermark — plus cursor:not-allowed. With the watermark gone
+   from eight scraps that whisper would vanish, so the veil layer carries it
+   instead: a locked scrap sits a shade flatter than a live one. The dashed
+   `.tearable` border remains the loud half of the pair, unchanged.
+   -------------------------------------------------------------------- */
+.df-scrap.locked { --veil: rgba(11,11,11,.05); }
+
+
+/* ##########################################################################
+   PAPER-SCRAPS MOCKUP — candidate-2-printed-sheet.css
+   Appended block. A shipping version would fold these overrides
+   into the .df-scrap rules above rather than restating them.
+   ########################################################################## */
+/* ==========================================================================
+   CANDIDATE 2 — "ONE PRINTED SHEET"                   (mockup, 7 Aug 2026)
+   Paper-scraps art direction. NOT SHIPPED.
+   APPLY CANDIDATE 1 FIRST — this file is the delta on top of it.
+
+   Candidate 1 makes nine different sheets. This makes them one sheet again:
+   a single extremely faint composition is printed across the WHOLE cover and
+   the nine scraps each carry a different fragment of it — a cropped masthead
+   over the top row, a double newspaper rule under it, a column rule, a patch
+   of halftone residue bottom-left, registration crosshairs at two corners
+   and CMYK bars in the right-hand margin. Scraps 3, 4, 7 and 8 carry a
+   hairline or nothing at all: roughly half the cover stays blank.
+
+   PRINT FURNITURE ONLY. No facts, no dates, no illustrations, no words that
+   could be read as a clue: the only lettering is the house name at a size
+   that crops it to letterforms, which is what a masthead is.
+
+   The pieces rotate independently (the game sets an inline rotate per
+   scrap), so the composition does NOT line up perfectly across the seams —
+   it is a sheet that was torn and whose pieces then shifted. That is the
+   point, not a bug.
+
+   Mechanism: one shared 300x300 SVG, inlined as a data URI so this patch has
+   no file dependency, drawn on ::before at background-size 300% 300% with a
+   background-position per grid index. One asset, nine crops, no JS.
+
+   KNOWN LIMIT: the masthead is set in Georgia (a system serif), because an
+   SVG used as a background image cannot reach the app's own webfont. A
+   shipping version would convert those letterforms to paths — half an hour,
+   and it also makes the file smaller.
+   ========================================================================== */
+
+.df-scrap::before {
+  content: ''; position: absolute; inset: 0; pointer-events: none;
+  background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20viewBox%3D%270%200%20300%20300%27%20width%3D%27300%27%20height%3D%27300%27%3E%20%3Cdefs%3E%20%3Cpattern%20id%3D%27h%27%20width%3D%275%27%20height%3D%275%27%20patternUnits%3D%27userSpaceOnUse%27%3E%3Ccircle%20cx%3D%271.4%27%20cy%3D%271.4%27%20r%3D%271.2%27%20fill%3D%27%230B0B0B%27%2F%3E%3C%2Fpattern%3E%20%3CradialGradient%20id%3D%27f%27%3E%3Cstop%20offset%3D%27.05%27%20stop-color%3D%27%23fff%27%20stop-opacity%3D%271%27%2F%3E%3Cstop%20offset%3D%271%27%20stop-color%3D%27%23fff%27%20stop-opacity%3D%270%27%2F%3E%3C%2FradialGradient%3E%20%3Cmask%20id%3D%27m%27%3E%3Cellipse%20cx%3D%2744%27%20cy%3D%27256%27%20rx%3D%2786%27%20ry%3D%2762%27%20fill%3D%27url%28%23f%29%27%2F%3E%3C%2Fmask%3E%20%3C%2Fdefs%3E%20%3Ctext%20x%3D%27-46%27%20y%3D%2766%27%20font-family%3D%27Georgia%2CTimes%20New%20Roman%2Cserif%27%20font-size%3D%27104%27%20font-weight%3D%27700%27%20letter-spacing%3D%271%27%20fill%3D%27%230B0B0B%27%20opacity%3D%27.030%27%3EYESTERNERD%3C%2Ftext%3E%20%3Cg%20stroke%3D%27%230B0B0B%27%20fill%3D%27none%27%3E%20%3Cline%20x1%3D%278%27%20y1%3D%27112%27%20x2%3D%27292%27%20y2%3D%27112%27%20stroke-width%3D%271.4%27%20opacity%3D%27.085%27%2F%3E%20%3Cline%20x1%3D%278%27%20y1%3D%27116.5%27%20x2%3D%27292%27%20y2%3D%27116.5%27%20stroke-width%3D%27.7%27%20opacity%3D%27.065%27%2F%3E%20%3Cline%20x1%3D%27196%27%20y1%3D%27131%27%20x2%3D%27196%27%20y2%3D%27287%27%20stroke-width%3D%27.8%27%20opacity%3D%27.060%27%2F%3E%20%3Cline%20x1%3D%2714%27%20y1%3D%27197%27%20x2%3D%27104%27%20y2%3D%27197%27%20stroke-width%3D%27.7%27%20opacity%3D%27.050%27%2F%3E%20%3C%2Fg%3E%20%3Crect%20x%3D%270%27%20y%3D%27186%27%20width%3D%27160%27%20height%3D%27114%27%20fill%3D%27url%28%23h%29%27%20opacity%3D%27.085%27%20mask%3D%27url%28%23m%29%27%2F%3E%20%3Cg%20stroke%3D%27%230B0B0B%27%20fill%3D%27none%27%20stroke-width%3D%27.9%27%20opacity%3D%27.15%27%3E%3Ccircle%20cx%3D%27266%27%20cy%3D%2738%27%20r%3D%279%27%2F%3E%3Cpath%20d%3D%27M266%2024v28M252%2038h28%27%2F%3E%3C%2Fg%3E%20%3Cg%20stroke%3D%27%230B0B0B%27%20fill%3D%27none%27%20stroke-width%3D%27.8%27%20opacity%3D%27.10%27%3E%3Ccircle%20cx%3D%2733%27%20cy%3D%27285%27%20r%3D%277%27%2F%3E%3Cpath%20d%3D%27M33%20274v22M22%20285h22%27%2F%3E%3C%2Fg%3E%20%3Cg%20opacity%3D%27.13%27%3E%3Crect%20x%3D%27282%27%20y%3D%27130%27%20width%3D%2712%27%20height%3D%275%27%20fill%3D%27%232FC9E8%27%2F%3E%3Crect%20x%3D%27282%27%20y%3D%27137%27%20width%3D%2712%27%20height%3D%275%27%20fill%3D%27%23FF3DDB%27%2F%3E%3Crect%20x%3D%27282%27%20y%3D%27144%27%20width%3D%2712%27%20height%3D%275%27%20fill%3D%27%23FFE93B%27%2F%3E%3Crect%20x%3D%27282%27%20y%3D%27151%27%20width%3D%2712%27%20height%3D%275%27%20fill%3D%27%230B0B0B%27%2F%3E%3C%2Fg%3E%20%3C%2Fsvg%3E");
+  background-size: 300% 300%;
+  background-repeat: no-repeat;
+  /* One knob for the whole composition. Below ~.6 it disappears on a phone;
+     above ~1.4 it starts to look like a pattern instead of a ghost. */
+  opacity: var(--sheet-strength, 1);
+}
+
+.df-scrap[data-i="0"]::before { background-position: 0% 0%; }
+.df-scrap[data-i="1"]::before { background-position: 50% 0%; }
+.df-scrap[data-i="2"]::before { background-position: 100% 0%; }
+.df-scrap[data-i="3"]::before { background-position: 0% 50%; }
+.df-scrap[data-i="4"]::before { background-position: 50% 50%; }
+.df-scrap[data-i="5"]::before { background-position: 100% 50%; }
+.df-scrap[data-i="6"]::before { background-position: 0% 100%; }
+.df-scrap[data-i="7"]::before { background-position: 50% 100%; }
+.df-scrap[data-i="8"]::before { background-position: 100% 100%; }
+
+/* The printer's mark from candidate 1 sits over the sheet, not under it. */
+.df-scrap[data-i="8"]::after { z-index: 1; }
+
