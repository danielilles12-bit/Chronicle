# Cloudflare Pages cache policy (Session 8 / P5.4). GitHub Pages ignores this
# file, so it is harmless on the old host during the farewell period.
# Images never change under a given filename — cache hard, forever.
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable
# The service worker and the editions manifest are the two files whose
# freshness delivers updates — never let an edge cache hold them back.
/sw.js
  Cache-Control: no-cache
/data/editions.json
  Cache-Control: no-cache
# Static brand/font/intro assets: conservative day-long cache, NOT immutable —
# brand files have historically been replaced under the same filename.
/assets/fonts/*
  Cache-Control: public, max-age=86400
/assets/brand/*
  Cache-Control: public, max-age=86400
/assets/intro/*
  Cache-Control: public, max-age=86400
/assets/splash/*
  Cache-Control: public, max-age=86400
